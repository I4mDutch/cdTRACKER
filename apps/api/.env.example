# VALORANT Analyzer API configuration. Copy to .env and export the values (the app does not load .env itself).
# With NO variables set, the API runs in demo mode: PGlite (in-memory) + fixture Riot data + mock RSO.

PORT=3000

# Postgres connection string. Leave unset to use PGlite.
# DATABASE_URL=postgres://user:password@localhost:5432/valorant_analyzer
# Directory for persistent PGlite data when DATABASE_URL is unset (unset = in-memory, lost on restart).
# PGLITE_DIR=./.pglite

# Defaults to true when RIOT_API_KEY is unset. In demo mode: fixtures + mock RSO + POST /api/dev/login.
# DEMO_MODE=true

# Required when DEMO_MODE is false (values come from the Riot developer portal):
# RIOT_API_KEY=
# RSO_CLIENT_ID=
# RSO_CLIENT_SECRET=
# RSO_REDIRECT_URI=https://your-host.example/api/riot/callback

# Web app origin, used for share links and redirects after RSO sign-in.
PUBLIC_BASE_URL=http://localhost:5173

SESSION_TTL_HOURS=168
# Defaults to true unless DEMO_MODE (browsers will not store Secure cookies over plain http).
# COOKIE_SECURE=true
RAW_RETENTION_DAYS=30
# Background re-sync of linked accounts; 0 = off.
SYNC_INTERVAL_MINUTES=0

# In-memory per-IP rate limits (requests per minute).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SENSITIVE_PER_MINUTE=6
